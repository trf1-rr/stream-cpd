# ---- Camera / DVR -----------------------------------------------------------
RTSP_USER=admin
RTSP_PASSWORD=admin
RTSP_HOST=172.29.4.120
RTSP_PORT=554

# {channel} e {subtype} sao substituidos por canal. Padrao Dahua/Intelbras:
RTSP_PATH=/cam/realmonitor?channel={channel}&subtype={subtype}
# 0 = stream principal (HD, pesado) | 1 = substream (leve, recomendado)
RTSP_SUBTYPE=1
# tcp e mais confiavel; udp tem menos latencia mas perde pacotes
RTSP_TRANSPORT=tcp

# Canais exibidos. Aceita "1,2,3", "1-8" ou "1-4,7,9"
CHANNELS=1-4

# ---- Video ------------------------------------------------------------------
# false = copia o H.264 da camera (CPU baixa, recomendado)
# true  = reencoda para H.264 (use se a camera for H.265/HEVC)
TRANSCODE=false
VIDEO_BITRATE=1200k
X264_PRESET=veryfast
AUDIO=false

# ---- HLS / latencia ---------------------------------------------------------
HLS_TIME=1
HLS_LIST_SIZE=6

# ---- Ciclo de vida dos processos -------------------------------------------
IDLE_TIMEOUT=30
START_TIMEOUT=20
RESTART_BACKOFF=3

# ---- Sensores SNMP (overlay de temperatura/umidade no video) ----------------
# Le um controlador Conflex por SNMP v1 e sobrepoe as leituras no player.
# Ponha SNMP_ENABLED=false para desligar o overlay. As OIDs ficam em
# app/config.py (SNMP_SENSORS / SNMP_ALARMS).
SNMP_ENABLED=true
SNMP_HOST=172.29.4.22
SNMP_COMMUNITY=public
SNMP_PORT=161
